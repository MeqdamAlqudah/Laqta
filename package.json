{
  "name": "leadflow",
  "version": "1.0.0",
  "private": true,
  "description": "LeadFlow - automated lead capture & follow-up system (Next.js + PostgreSQL)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "docs:pdf": "node docs/build-pdf.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "libphonenumber-js": "1.13.15",
    "next": "15.5.27",
    "nodemailer": "7.0.13",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/node": "22.18.0",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "prisma": "6.19.3",
    "puppeteer-core": "^24.22.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
