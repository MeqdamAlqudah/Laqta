# ---------------------------------------------------------------
# LeadFlow environment template. Copy to .env and fill in values.
# Never commit .env - it holds secrets.
# ---------------------------------------------------------------

# --- Database (PostgreSQL) ---
# Local Docker (npm run db:up):
DATABASE_URL="postgresql://leadflow:leadflow@localhost:5432/leadflow?schema=public"
# Supabase: Project Settings -> Database -> Connection string.
#   DATABASE_URL = the "Transaction pooler" URL (port 6543) + "?pgbouncer=true"
#   DIRECT_URL   = the "Session"/direct URL (port 5432) - used only by migrations
DIRECT_URL="postgresql://leadflow:leadflow@localhost:5432/leadflow?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# 32-byte key, base64 encoded - encrypts integration credentials stored in the DB.
ENCRYPTION_KEY="9Hk0m0b8m7V1y4rXn0QJm2f1mA6c3wq8Y0yQ8hL1s2E="
# Salt for hashing IP addresses stored as consent evidence.
IP_HASH_SALT="change-me-too"

# --- Background jobs ---
# Protects GET/POST /api/v1/jobs/run (call it from a cron service in production).
CRON_SECRET="change-me-cron-secret"
# Bearer token that automation tools (n8n/Make) use for staff-level API calls.
SERVICE_API_TOKEN="change-me-service-token"
# Shared secret used to verify signed webhooks at /api/v1/webhooks/{provider}.
WEBHOOK_SECRET="change-me-webhook-secret"

# --- Email (SMTP) ---
# Local Mailpit (from docker-compose): host localhost, port 1025, no auth.
# Leave SMTP_HOST empty to only log emails to the console.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="LeadFlow <no-reply@leadflow.local>"

# --- AI classification (optional) ---
# Without a key LeadFlow uses the built-in rule-based classifier.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# --- Public form abuse protection (optional) ---
# Cloudflare Turnstile secret. When set, the public endpoint requires a valid token.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
